# Recipes for the USS Philadelphia build123d model.

# Show available recipes.
default:
    @just --list

# Install/refresh the virtualenv from uv.lock.
sync:
    uv sync

# Leave this running in its own terminal; `just watch` pushes models to it.
# Not needed if you use the OCP CAD Viewer panel inside VS Code instead.
[doc("Start the OCP CAD Viewer in the browser (http://127.0.0.1:3939)")]
viewer port="3939":
    uv run python -m ocp_vscode --port {{ port }}

# Keeps build123d imported between reloads, so a save repaints in ~0.2s
# instead of paying the ~16s cold import every time. Start `just viewer` first.
# Defaults to the assembled boat, since that is the thing worth looking at;
# `just watch main.py` for the hull and the parts as they print.
# PREVIEW lets the model pick cheaper settings for the loop; since it only
# affects smoothness, the shape you are judging is the real one. Run
# `uv run watch.py` directly for full detail.
[doc("Watch model files and live-reload them into the running viewer")]
watch +files="assembly.py":
    PREVIEW=1 uv run watch.py {{ files }}

# Export for slicing. 3MF carries the unit, so the slicer does not have to
# guess millimetres; --stl and --step are there if something else wants them.
[doc("Export the model to dist/ as 3MF")]
build *args:
    uv run export.py {{ args }}

# Render a model once, without the watcher.
run file="main.py":
    uv run {{ file }}

# Useful in a headless session, where `just viewer` has no browser to draw into.
# Runs the model with PREVIEW set, so it can pick cheaper settings; pass --full
# to render at the same detail as the real thing.
[doc("Render the model to SVG (and PNG if Chromium is available) in preview/")]
preview *args:
    uv run preview.py {{ args }}

[doc("Run the tests")]
test *args:
    uv run pytest {{ args }}

# Format code with ruff.
format:
    uv run ruff format .
    uv run ruff check --fix .

# Lint and type-check.
check:
    uv run ruff format --check .
    uv run ruff check .
    uv run pyright
